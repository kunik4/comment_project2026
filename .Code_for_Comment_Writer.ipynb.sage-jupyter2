{"cell_type":"code","end":1770836076536,"exec_count":13,"id":"d02a83","input":"#name, course, attributes, key grades, learning outcomes, suggestions, sem grade\n#file name = student_name.txt\n#pep8\n#intro is the same for the course\n\n# asks the teacher if they wish to add another student to their file. Then they short response a few questions so that the program can generate a larger comment for them.\n\n\ndef newstudent():\n    while True:\n        yes_no = input(\"Would you like to add in another student? (yes/no)\"\n                       ).strip().lower()\n        if yes_no == \"yes\":\n            print(\"Great! Please answer the questions below.\")\n            name = input(\"First Name: \")\n            course = input(\"Course Title: \")\n            attributes = input(\n                \"Attributes (work ethic, behavior, skills, etc.) Please insert two adjectives: \"\n            )\n            grades = input(\n                \"Over all performance: grade on the final exam. (Please seperate using the colon): \"\n            )\n            outcomes = input(\n                \"Focus on Learning Outcomes (please only enter in: writing, listening, reading, or speaking): \"\n            )\n            suggestions = input(\"Suggestions for improvement (the student should...): \")\n            final_grade = input(\"Final Grade in the class: \")\n\n            with open(\"teacher.csv\", \"a\", newline=\"\") as f:\n                writer = csv.writer(f)\n                writer.writerow([\n                    name, course, attributes, grades, outcomes, suggestions,\n                    final_grade\n                ])\n                print(f\"{name} has been added successfully!\\n\")\n        elif yes_no == \"no\":\n            print(\"Finished adding students.\\n\")\n            break\n        else:\n            print(\"Please enter 'yes' or 'no'\\n\")\n\n\n#once the teacher has added the amount of kids they desire, then we begin writing the comments for each student.\n\n\n#this function reads the updated file and returns the data in each collum for each student so we can form the full comment.\ndef read_csv(file_name):\n    \"\"\"\n    Reads the teacher CSV and returns a list of student data\n    \"\"\"\n    students = []\n    with open(file_name, \"r\", newline=\"\") as f:\n        reader = csv.reader(f)\n        headers = next(reader)\n        for row in reader:\n            students.append(row)\n    return students","kernel":"anaconda2022","last":193,"pos":1,"start":1770836076507,"state":"done","type":"cell"}

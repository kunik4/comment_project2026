{"end":1770836206571,"exec_count":15,"id":"0831be","input":"import csv\n\n#Make the file with students in the course. The header shows what goes in each collum of the file, which teacher can imput.\nfile_name = \"teacher.csv\"\n\nheaders = [\n    \"Name\", \"Course\", \"Attributes\", \"Key Grades\", \"Work On Learning Outcomes\",\n    \"Suggestions\", \"Final Grade\"\n]\n\nstudents = [{\n    \"Name\": \"Tulip\",\n    \"Course\": \"Chinese III\",\n    \"Attributes\": \"hard working, resilant\",\n    \"Key Grades\": \"A's on all tests: 97% on final exam\",\n    \"Work On Learning Outcomes\": \"tones\",\n    \"Suggestions\": \"Come to peer language mentors during office hours\",\n    \"Final Grade\": \"A\"\n}, {\n    \"Name\": \"Daisy\",\n    \"Course\": \"Chinese III\",\n    \"Attributes\":\n    \"always engaged, curious \",\n    \"Key Grades\": \"B's on most tests: 88% on the final exam\",\n    \"Work On Learning Outcomes\": \"writing and listening\",\n    \"Suggestions\":\n    \"Come by during office hours to study for dictation quizzes\",\n    \"Final Grade\": \"B+\"\n}]\n\nrows = []\nfor student in students:\n    row = [student[h] for h in headers]\n    rows.append(row)\nwith open(file_name, \"w\", newline=\"\") as f:\n    writer = csv.writer(f)\n    writer.writerow(headers)\n    writer.writerows(rows)","kernel":"anaconda2022","last":62,"pos":0.75,"start":1770836206488,"state":"done","type":"cell"}
{"end":1770836482442,"exec_count":24,"id":"94c8b1","input":"def attributes(stdnt):\n    \"\"\"\n    Takes in the attributes of the student,\n    returning a sentence with the information incorperated. \n    \"\"\"\n    parts_new = stdnt[2].split(\", \")\n    adj1 = parts_new[0]\n    adj2 = parts_new[1]\n    return f\"{stdnt[0]}, you are {adj1.strip()} and {adj2.strip()}, making you a joy to have in class. I hope to keep hearing your voice.\"\n\n    for notes in all_adjs:\n        print(notes)\n\n\ndef key_grades(stdnt):\n    \"\"\"\n    Takes in the overall performance and the final exam grade of the student,\n    returning a sentence with the information incorperated. \n    \"\"\"\n    sections_new = stdnt[3].split(\": \")\n    overall = sections_new[0]\n    final = sections_new[1]\n    grade_num = final.split(\"%\")\n    is_it_a_ninty = grade_num[0]\n    if is_it_a_ninty[0] == \"9\" or is_it_a_ninty[0:2] == \"10\":\n        return f\"Throughout the semester, you recieved {overall}, and finished the year with a {final}.\"\n\n    else:\n        return f\"Throughout the semester, you recieved {overall}, and finished the year with an {final}.\"\n\n\ndef outcome_recs(stdnt):\n    \"\"\"\n    Takes in the areas of improvement for the student,\n    returning a sentence with the information incorperated. \n    \"\"\"\n    outcome = stdnt[4]\n    suggest = stdnt[5]\n    if 'and' in outcome:\n        return (\n            f\"For your areas of growth, I suggest that we work on your {outcome}. To improve in these section, you should {suggest.lower()}.\"\n        )\n    else:\n        return (\n            f\"For your area of growth, I suggest that we work on your {outcome}. To improve in this section, you should{suggest.lower()}.\"\n        )\n\n\ndef final_grade(stdnt):\n    \"\"\"\n    Takes in the final letter grade of the student,\n    returning a sentence with the information incorperated. \n    \"\"\"\n\n    gradde = stdnt[6]\n\n    if \"A\" in gradde:\n        return f\"Overall, you will recieve an {gradde} for semester 1. Strong work this year. Keep it up!\"\n    elif \"B\" in gradde:\n        return f\"Overall, you will recieve a {gradde} for semester 1. Strong work this year, let's keep pushing forward and please come to me with any questions.\"\n    elif \"F\" in gradde:\n        return f\"Overall, you will recieve an {gradde} for semester 1. Let's keep talking and see what we can do to get you a credit for this course.\"\n    else:\n        return f\"Overall, you will recieve a {gradde} for semester 1. Good job so far, I really enoy your presence in this class.\"\n\n\ndef put_it_together(file_name=\"teacher.csv\"):\n    stdnt = read_csv(file_name)\n    for studs in stdnt:\n\n        intro = f\"This semester in {studs[1]}, we have continued building on the foundations of speaking, listening, reading, and writing in Mandarin. Students practiced more complex sentence strutures, expanded their vocabulary, and explored culteral topics through conversations, tests, and projects.\"\n\n        full_com = \" \".join([\n            intro,\n            attributes(studs),\n            key_grades(studs),\n            outcome_recs(studs),\n            final_grade(studs)\n        ])\n        print(\"\\n\" + full_com + \"\\n\")\n        fffname = f\"{studs[0]}_comment.txt\"\n        with open(fffname, \"w\") as f:\n            f.write(full_com)\n\n        print(\"A file for this indivial student has additionally been made!\")\n        print()\n\n\nnewstudent()\nput_it_together()","kernel":"anaconda2022","last":1776,"output":{"0":{"name":"input","opts":{"password":false,"prompt":"Would you like to add in another student? (yes/no)"},"value":"no"},"1":{"name":"stdout","text":"Finished adding students.\n\n\nThis semester in Chinese III, we have continued building on the foundations of speaking, listening, reading, and writing in Mandarin. Students practiced more complex sentence strutures, expanded their vocabulary, and explored culteral topics